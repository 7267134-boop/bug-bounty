# ============================================================================
# Bug Bounty Automation Platform - STAGE 1 configuration template
# Copy to .env and REPLACE EVERY SECRET before deploying.
#   cp .env.example .env
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=bb_platform
POSTGRES_USER=bb_app
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_pg_password

# --- Redis ------------------------------------------------------------------
# generate: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# --- Master API -------------------------------------------------------------
# Bearer-style token required in the X-API-Token header on every API call.
# generate: openssl rand -hex 32
MASTER_API_TOKEN=CHANGE_ME_api_token
MASTER_PORT=8080

# --- Worker -----------------------------------------------------------------
WORKER_ID=worker-01
# Capability allowlist. Stage 1 ONLY exposes the built-in no-op tool.
# Later stages add: subfinder, assetfinder, httpx, katana, nuclei, ffuf, ...
WORKER_CAPABILITIES=builtin.noop
# Stage-4 focused scanning / visual recon (enable after building the image):
#   dalfox needs no extra deps; gowitness requires the Chromium block in worker/Dockerfile
# WORKER_CAPABILITIES=builtin.noop,dalfox,gowitness
# Stage-3 routed tools (wpscan/corsy binaries must exist in the image):
# WORKER_CAPABILITIES=builtin.noop,routing.bypass403,wpscan,corsy
# Stage-4 focused scanning (ffuf/arjun/sqlmap/trufflehog in the image):
# WORKER_CAPABILITIES=builtin.noop,ffuf,arjun,sqlmap,trufflehog,interactsh
# WPSCAN_API_TOKEN=                     # optional, via WORKER_ENV_PASSTHROUGH
WORKER_CONCURRENCY=2
# Politeness ceiling: max tool launches per second per worker (token bucket).
WORKER_RATE_RPS=10
# Comma-separated env vars forwarded INTO tool processes (provider API keys).
# Only list what you actually set below - everything else stays sealed.
# WORKER_ENV_PASSTHROUGH=SHODAN_API_KEY,SECURITYTRAILS_API_KEY,CHAOS_API_KEY
SHODAN_API_KEY=
SECURITYTRAILS_API_KEY=
CHAOS_API_KEY=
# Optional webhook for scan lifecycle notifications (notify-style).
# Any JSON-accepting endpoint works (Discord/Slack relay, custom receiver).
WEBHOOK_URL=

# --- Platform tuning --------------------------------------------------------
# NOTE: every value in this block is on the manual-tuning checklist
# (docs/TUNING.md) -- revisit once final tuning data is available.
LOG_LEVEL=INFO
TASK_TIMEOUT_SECS=600
STALE_REQUEUE_SECS=900
MAX_OUTPUT_BYTES=1000000
# Worker consume-loop error backoff (exponential growth, capped, resets on
# first successful consume). Guards against CPU hot-spin during Redis outages.
CONSUME_ERROR_BACKOFF_SECS=3
CONSUME_ERROR_BACKOFF_MAX_SECS=30

# --- MCP server (Stage 5) ---------------------------------------------------
# Base URL the gateway uses to reach the Master from inside/outside compose.
MASTER_URL=http://localhost:8080
